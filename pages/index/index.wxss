.page {
  padding: 32rpx 0 60rpx;
  min-height: 100vh;
}

.date-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 44rpx 8rpx;
}

.date-str {
  font-size: 30rpx;
  font-weight: 600;
  color: #2f4a3d;
}

.date-week {
  font-size: 24rpx;
  color: #a49c8c;
  margin-top: 4rpx;
}

.date-total {
  font-size: 22rpx;
  color: #a49c8c;
}

.quote-card {
  position: relative;
  padding: 56rpx 44rpx 40rpx;
  margin-top: 32rpx;
}

.quote-mark {
  position: absolute;
  top: 8rpx;
  left: 32rpx;
  font-family: Georgia, serif;
  font-size: 120rpx;
  line-height: 1;
  color: rgba(176, 141, 70, 0.35);
}

.main-text {
  margin-top: 28rpx;
  font-size: 40rpx;
}

.next-btn {
  width: 320rpx;
  margin: 44rpx auto 0;
  text-align: center;
  color: #f7f3e8;
  background: #2f4a3d;
  border-radius: 999rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  letter-spacing: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(47, 74, 61, 0.3);
}

.next-btn:active {
  opacity: 0.85;
}

.footer {
  margin-top: 56rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b6455;
}

.footer.sub {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #b3ab9a;
}

/* ---------- 今日精选 ---------- */
.section {
  margin-top: 64rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #2f4a3d;
  letter-spacing: 6rpx;
}

.section-bar {
  width: 48rpx;
  height: 2rpx;
  background: rgba(176, 141, 70, 0.55);
  margin: 0 24rpx;
}

.five-item {
  padding: 30rpx 32rpx 24rpx;
  margin-top: 24rpx;
}

.cat-badge.small {
  font-size: 20rpx;
  padding: 4rpx 18rpx;
}

.five-text {
  font-family: 'Kaiti SC', 'KaiTi', 'STKaiti', 'BiauKai', serif;
  font-size: 31rpx;
  line-height: 1.8;
  color: #3a3630;
  margin-top: 18rpx;
  word-break: break-all;
}

.five-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.five-foot .src-line {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  font-size: 22rpx;
}

.five-acts {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.five-act {
  font-size: 24rpx;
  color: #8f8a7e;
  background: #f2ecdf;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin-left: 12rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.five-act.fav {
  color: #c0392b;
  background: #f9e3de;
}
