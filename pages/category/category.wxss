.page {
  padding: 28rpx 0 60rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  margin: 8rpx 32rpx 28rpx;
}

.search-input {
  flex: 1;
  background: #fffdf8;
  border-radius: 999rpx;
  padding: 18rpx 32rpx;
  font-size: 27rpx;
  color: #3a3630;
  box-shadow: 0 4rpx 16rpx rgba(72, 60, 40, 0.06);
}

.ph {
  color: #c2baa8;
}

.search-btn {
  margin-left: 20rpx;
  color: #fff;
  background: #2f4a3d;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 18rpx 36rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
}

.grid-item {
  width: 33.333%;
  box-sizing: border-box;
  padding: 12rpx;
}

.grid-inner-area {
  display: block;
}

.grid-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin: 8rpx auto 0;
}

.grid-name {
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  color: #3a3630;
  margin-top: 14rpx;
}

.grid-desc {
  text-align: center;
  font-size: 20rpx;
  color: #a49c8c;
  margin-top: 4rpx;
  padding: 0 6rpx;
}

.grid-count {
  text-align: center;
  font-size: 20rpx;
  color: #b08d46;
  margin-top: 8rpx;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #b3ab9a;
  margin-top: 48rpx;
}
