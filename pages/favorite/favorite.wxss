.page {
  padding: 24rpx 0 60rpx;
}

.item {
  padding: 36rpx 36rpx 28rpx;
}

.item-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-foot .src-line {
  margin-top: 20rpx;
  flex: 1;
  min-width: 0;
}

.item-acts {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.mini-act {
  font-size: 26rpx;
  color: #8f8a7e;
  background: #f2ecdf;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin-left: 12rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.mini-act.del {
  color: #b0552f;
  background: #f7e5d8;
}

.empty {
  text-align: center;
  color: #a49c8c;
  font-size: 26rpx;
  padding: 200rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 22rpx;
  margin-top: 12rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 40rpx;
  color: #fff;
  background: #2f4a3d;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 16rpx 60rpx;
}
